DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@gbte.in
ADMIN_PASSWORD=replace-with-a-desk-password
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Student portal
FRONTEND_URL=http://localhost:3000
PORTAL_TOKEN_TTL_HOURS=12
PORTAL_AUTH_RATE=10/min
PASSWORD_RESET_TIMEOUT_SECONDS=86400

# Online fee payments (Razorpay). Leave empty to keep online payment off.
# Test keys start with rzp_test_. Webhook URL: <PUBLIC_API_URL>/api/portal/finance/razorpay/webhook/ (events: payment.captured, order.paid)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RECEIPT_PREFIX=GBET-R-

# Email (console backend is used automatically when DJANGO_DEBUG=True)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=GBET Online <admission@gbedutrust.com>
