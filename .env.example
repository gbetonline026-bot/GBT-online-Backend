# ---- Core (SECRET_KEY / DEBUG / ALLOWED_HOSTS also work as short names) ----
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@gbte.in
ADMIN_PASSWORD=replace-with-a-desk-password

# ---- Database: leave empty locally (SQLite). Production: Neon PostgreSQL connection string ----
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# DB_CONN_MAX_AGE=60

# ---- Uploads: leave empty locally (private_media folder). Production: Cloudinary ----
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_FOLDER=gbet-online

# ---- Website and API addresses ----
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://127.0.0.1:8000

# ---- Student portal ----
PORTAL_TOKEN_TTL_HOURS=12
PORTAL_AUTH_RATE=10/min
PASSWORD_RESET_TIMEOUT_SECONDS=86400

# ---- Online fee payments (Razorpay). Leave empty to keep online payment off ----
# Webhook URL: <PUBLIC_API_URL>/api/portal/finance/razorpay/webhook/ (events: payment.captured, order.paid)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RECEIPT_PREFIX=GBET-R-

# ---- Email (console backend is used automatically when DEBUG is True) ----
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=GBET Online <admission@gbedutrust.com>
